---
import PageLayout from "../../layouts/PageLayout.astro";
import { getSessionUser } from "../../lib/auth";
import { expireOpenOrders, getOrderByNo, getProductById } from "../../lib/db";
import { env } from "../../lib/env";
import { getFulfillGuide } from "../../lib/fulfill-guide";
import { getUsdtConfig, paymentStatusLabel } from "../../lib/payment";
import { resolveShop16688PayUrl } from "../../lib/shop16688";

export const prerender = false;

expireOpenOrders();

const { orderNo } = Astro.params;
const order = orderNo ? getOrderByNo(orderNo) : undefined;
if (!order) {
  return Astro.rewrite("/404");
}

const product = getProductById(order.product_id);
const fulfillType = product?.fulfill_type || "card";
const guide = getFulfillGuide(product);
const isAlipay16688 = order.payment_channel === "alipay_16688";
const shop16688PayUrl = isAlipay16688 ? resolveShop16688PayUrl(product) : "";
const usdt = getUsdtConfig();
const payLabel = paymentStatusLabel(order.payment_status);
const isOpen =
  order.payment_status === "pending" || order.payment_status === "confirming";
const allowSimulate = env("ALLOW_PAYMENT_SIMULATE") === "1";
const sessionUser = getSessionUser(Astro.cookies);
const isOwnerSession =
  Boolean(sessionUser) &&
  sessionUser!.email.trim().toLowerCase() === order.email.trim().toLowerCase();
---

<PageLayout title={`付款 ${order.order_no} · Magfield`}>
  <section
    class="pay"
    data-testid="pay-page"
    data-order-no={order.order_no}
    data-expires-at={order.expires_at || ""}
    data-payment-status={order.payment_status}
    data-fulfill-type={fulfillType}
    data-email={order.email}
  >
    <div class="pay-head">
      <div>
        <h1>{isAlipay16688 ? "支付宝 / 微信付款" : "USDT 付款"}</h1>
        <p class="lead">
          {isAlipay16688 ? (
            <>
              点击下方按钮跳转至<strong>收银台对应商品页</strong>，使用支付宝或微信扫码付款；付款时请尽量填写与本站一致的邮箱{" "}
              <code>{order.email}</code>，付款完成后回到本页领取发货内容。
            </>
          ) : (
            <>
              请向下方地址转入<strong>精确应付金额</strong>（系统按金额自动匹配订单）。无需备注订单号，链上确认后自动发货。
            </>
          )}
        </p>
      </div>
      {
        isOpen ? (
          <span class="countdown-pill tabular" data-testid="pay-countdown">计算剩余时间…</span>
        ) : order.payment_status === "expired" ? (
          <span class="status-pill expired" data-testid="pay-expired">支付已过期</span>
        ) : order.payment_status === "paid" ? (
          <span class="status-pill paid">已完成付款</span>
        ) : null
      }
    </div>

    {
      order.payment_status === "expired" ? (
        <p class="expired-banner">
          支付窗口已过期。若已转账或已扫码付款，请联系客服 support@magfieldai.top 并提供交易号，或返回重新下单。
        </p>
      ) : null
    }

    <!-- Primary Alipay / WeChat CTA placed prominently above details when open -->
    {
      isAlipay16688 && isOpen ? (
        shop16688PayUrl ? (
          <div class="alipay-cta-box" data-testid="alipay-cta-box">
            <a
              class="alipay-cta-btn"
              href={shop16688PayUrl}
              target="_blank"
              rel="noopener noreferrer"
              data-testid="alipay-16688-link"
            >
              前往完成支付宝 / 微信付款 · ¥{order.amount_cny} ↗
            </a>
            <p class="alipay-cta-note">
              点击将在新窗口打开对应商品收银台（请核对商品为 <strong>{order.product_name}</strong>，金额 <strong>¥{order.amount_cny}</strong>）；支持支付宝与微信扫码，付款后请切回本页查看自动发货内容。
            </p>
          </div>
        ) : (
          <div class="hint" data-testid="alipay-url-missing">
            该商品暂未绑定收银台直达链接（管理员可在 <code>/admin</code> 后台填写商品编号或直达链接后立即生效）。
          </div>
        )
      ) : null
    }

    <!-- Delivery Result + Built-in Usage Tutorial (shown automatically once paid & fulfilled) -->
    <div id="deliver-panel" class="deliver" hidden data-testid="deliver-panel">
      <div class="deliver-head">
        <div>
          <span class="deliver-badge">已发货 · 请妥善保存</span>
          <h2 data-testid="deliver-title">发货内容与使用教程</h2>
        </div>
        <button
          type="button"
          class="copy-secret-btn"
          id="copy-secret-btn"
          data-testid="copy-secret-btn"
        >
          复制发货内容
        </button>
      </div>
      <p class="deliver-lead" data-testid="deliver-lead"></p>

      <div class="cred-card" data-testid="cred-card">
        <div class="cred-row"><span>订单号</span><code data-testid="cred-order-no">{order.order_no}</code></div>
        <div class="cred-row"><span>归属邮箱</span><strong data-testid="cred-email">{order.email}</strong></div>
        <div class="cred-row">
          <span>记录归档</span>
          <strong data-testid="cred-password">
            {isOwnerSession ? "已归档至您的邮箱轻账户" : "可通过顶部「历史订单」使用邮箱验证码随时找回"}
          </strong>
        </div>
        <div class="cred-secret">
          <div class="muted" data-testid="secret-label">发货内容</div>
          <pre data-testid="deliver-secret"></pre>
        </div>
      </div>

      <p class="deliver-note" data-testid="deliver-note">
        请立即复制或截图保存，并按下方使用教程完成激活；后续可随时在页面顶部「历史订单」查看全部记录。
      </p>
    </div>

    <!-- Prominent Always-Expanded Usage & Activation Guide -->
    <div class="guide-card" data-testid="deliver-guide">
      <div class="guide-card-head">
        <div>
          <span class="guide-badge" id="guide-stage-badge">
            {isOpen ? "付款后操作指南" : "立即激活指南"}
          </span>
          <h2>{guide.title}</h2>
          <p class="guide-sub">{guide.subtitle}</p>
        </div>
        {
          guide.actionUrl ? (
            <a
              class="guide-action-link"
              href={guide.actionUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              {guide.actionLabel}
            </a>
          ) : null
        }
      </div>
      <ol class="guide-steps">
        {
          guide.steps.map((step, i) => (
            <li>
              <span class="step-num tabular" aria-hidden="true">{i + 1}</span>
              <span class="step-text">{step}</span>
            </li>
          ))
        }
      </ol>
    </div>

    <!-- Order Details Panel -->
    <div class="panel">
      <div class="row"><span>订单号</span><code data-testid="pay-order-no">{order.order_no}</code></div>
      <div class="row"><span>套餐</span><strong>{order.product_name}</strong></div>
      <div class="row"><span>接收邮箱</span><strong>{order.email}</strong></div>
      {
        isAlipay16688 ? (
          <>
            <div class="row"><span>支付方式</span><strong>支付宝 / 微信扫码</strong></div>
            <div class="row"><span>应付金额</span><strong class="tabular" data-testid="pay-cny">¥{order.amount_cny}</strong></div>
            {product?.shop16688_goods_no ? (
              <div class="row"><span>商品编号</span><code>{product.shop16688_goods_no}</code></div>
            ) : null}
          </>
        ) : (
          <>
            <div class="row value-row">
              <span>应付金额</span>
              <div class="value-actions">
                <strong class="tabular" data-testid="pay-usdt">{order.amount_usdt} USDT</strong>
                <button
                  type="button"
                  class="inline-copy-btn"
                  data-copy={String(order.amount_usdt)}
                  data-testid="copy-amount"
                >
                  复制金额
                </button>
              </div>
            </div>
            <div class="row"><span>参考人民币</span><strong class="tabular">¥{order.amount_cny}</strong></div>
            <div class="row"><span>网络</span><strong>{usdt.network}</strong></div>
            <div class="row value-row">
              <span>收款地址</span>
              <div class="value-actions">
                <code class="break" data-testid="pay-address">{usdt.address}</code>
                <button
                  type="button"
                  class="inline-copy-btn"
                  data-copy={usdt.address}
                  data-testid="copy-address"
                >
                  复制地址
                </button>
              </div>
            </div>
          </>
        )
      }
      {
        order.expires_at ? (
          <div class="row">
            <span>支付截止</span>
            <strong class="tabular" data-testid="pay-expires">{order.expires_at}</strong>
          </div>
        ) : null
      }
      <div class="row">
        <span>支付状态</span>
        <div class="value-actions">
          <strong data-testid="pay-status">{payLabel}</strong>
          {isOpen ? (
            <button type="button" class="inline-refresh-btn" data-testid="manual-refresh">
              ↻ 刷新状态
            </button>
          ) : null}
        </div>
      </div>
      <div class="row"><span>发货状态</span><strong data-testid="fulfill-status">—</strong></div>
    </div>

    {
      !isAlipay16688 && isOpen ? (
        <div class="hint">
          金额必须与页面显示的 <code data-testid="pay-usdt-exact">{order.amount_usdt}</code> USDT
          完全一致（含小数），以便链上自动匹配。请勿多转或少转。
        </div>
      ) : null
    }

    <p id="copy-toast" class="toast" hidden data-testid="copy-toast">已复制</p>
    <p id="pay-poll-msg" class="poll-msg" data-testid="pay-poll-msg" hidden></p>

    {
      isOpen ? (
        <div class="txid-box" data-testid="txid-box">
          <h2>{isAlipay16688 ? "已完成扫码付款？粘贴收银台订单号核对" : "未自动到账？粘贴交易号"}</h2>
          <p class="txid-help">
            {isAlipay16688
              ? "完成支付宝 / 微信付款后，可在此输入收银台订单号（如 FF261127...）立即核对并自动发货；若暂未自动到账，可携带单号联系客服确认。"
              : "从钱包或交易所复制 TxID / 交易哈希，我们会在链上验真后自动发货。"}
          </p>
          <form id="txid-form" data-testid="txid-form">
            <input
              name="txId"
              required
              minlength={isAlipay16688 ? 6 : 16}
              placeholder={isAlipay16688 ? "输入收银台订单号（如 FF261127102066）" : "64 位交易哈希"}
              data-testid="txid-input"
            />
            <button type="submit" class="btn btn-primary" data-testid="txid-submit">
              {isAlipay16688 ? "核对发货" : "提交验真"}
            </button>
          </form>
          <p id="txid-error" class="error" hidden data-testid="txid-error"></p>
        </div>
      ) : null
    }

    {
      allowSimulate && isOpen ? (
        <div class="sim-box" data-testid="simulate-box">
          <span class="sim-label">本地开发调试工具（生产环境不可见）</span>
          <button type="button" class="btn btn-sm sim-btn" data-testid="simulate-pay">
            模拟付款成功并出卡
          </button>
        </div>
      ) : null
    }

    <div class="actions">
      <a class="back-link" href="/#subscribe">← 返回订阅方案</a>
      <span class="support-hint">
        遇到付款或使用问题？联系 <a href="mailto:support@magfieldai.top">support@magfieldai.top</a>
      </span>
    </div>
  </section>
</PageLayout>

<script>
  const root = document.querySelector("[data-testid=pay-page]") as HTMLElement | null;
  const toast = document.getElementById("copy-toast");
  const countdown = document.querySelector("[data-testid=pay-countdown]");
  const statusEl = document.querySelector("[data-testid=pay-status]");
  const fulfillEl = document.querySelector("[data-testid=fulfill-status]");
  const pollMsg = document.getElementById("pay-poll-msg");
  const deliverPanel = document.getElementById("deliver-panel");
  const copySecretBtn = document.getElementById("copy-secret-btn") as HTMLButtonElement | null;
  const orderNo = root?.dataset.orderNo || "";
  const fulfillType = root?.dataset.fulfillType || "card";
  const storageKey = `mf_qp_${orderNo}`;

  let deliveredSecretText = "";

  function getQueryPassword() {
    try {
      return sessionStorage.getItem(storageKey) || "";
    } catch {
      return "";
    }
  }

  function fulfillLabel(s: string) {
    if (s === "done") return "已发货";
    if (s === "processing") return "提取中";
    if (s === "error") return "发货异常";
    if (s === "none") return "待支付后发货";
    return s || "—";
  }

  async function copyText(text: string, label = "已复制") {
    try {
      await navigator.clipboard.writeText(text);
    } catch {
      const ta = document.createElement("textarea");
      ta.value = text;
      document.body.appendChild(ta);
      ta.select();
      document.execCommand("copy");
      ta.remove();
    }
    if (toast) {
      toast.hidden = false;
      toast.textContent = label;
      setTimeout(() => {
        toast.hidden = true;
      }, 1800);
    }
  }

  root?.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((btn) => {
    btn.addEventListener("click", () => {
      void copyText(btn.dataset.copy || "");
    });
  });

  copySecretBtn?.addEventListener("click", () => {
    if (!deliveredSecretText) return;
    void copyText(deliveredSecretText, "已复制发货内容");
  });

  const expiresAt = root?.dataset.expiresAt;
  if (countdown && expiresAt) {
    const tick = () => {
      const end = Date.parse(expiresAt.includes("T") ? expiresAt : expiresAt.replace(" ", "T") + "Z");
      const left = end - Date.now();
      if (!Number.isFinite(end) || left <= 0) {
        countdown.textContent = "支付窗口已结束";
        return;
      }
      const m = Math.floor(left / 60000);
      const s = Math.floor((left % 60000) / 1000);
      countdown.textContent = `剩余 ${m}:${String(s).padStart(2, "0")}`;
    };
    tick();
    setInterval(tick, 1000);
  }

  let pollCount = 0;
  const MAX_AUTO_POLLS = 6;
  let pollTimer: ReturnType<typeof setInterval> | undefined;
  let phase: "pay" | "fulfill" | "done" = "pay";

  function showDeliver(data: {
    deliverSecret?: string | null;
    email?: string;
  }) {
    if (!deliverPanel) return;
    deliverPanel.hidden = false;
    deliveredSecretText = data.deliverSecret || "";
    const lead = document.querySelector("[data-testid=deliver-lead]");
    const secretLabel = document.querySelector("[data-testid=secret-label]");
    const secretEl = document.querySelector("[data-testid=deliver-secret]");
    if (lead) {
      lead.textContent =
        fulfillType === "account"
          ? "成品账号资料已发放，请先复制保存，并按下方步骤登录。"
          : fulfillType === "manual"
            ? "订单已支付并生成人工代充记录，请按下方步骤联系客服完成代充。"
            : "充值卡密已自动发放，请复制卡密并按照下方 3 步完成激活。";
    }
    if (secretLabel) {
      secretLabel.textContent =
        fulfillType === "account"
          ? "成品账号资料"
          : fulfillType === "manual"
            ? "人工代充凭据"
            : "卡密 / 充值内容";
    }
    if (secretEl) secretEl.textContent = deliveredSecretText;

    // Update guide badge & hide unpaid sections once delivered
    const guideBadge = document.getElementById("guide-stage-badge");
    if (guideBadge) guideBadge.textContent = "立即按以下 3 步激活";
    document.querySelector<HTMLElement>("[data-testid=alipay-cta-box]")?.setAttribute("hidden", "");
    document.querySelector<HTMLElement>("[data-testid=txid-box]")?.setAttribute("hidden", "");
    document.querySelector<HTMLElement>("[data-testid=simulate-box]")?.setAttribute("hidden", "");
  }

  async function refreshPayment(force = false) {
    if (!orderNo) return;
    if (!force && pollCount >= MAX_AUTO_POLLS && phase !== "fulfill") {
      if (pollMsg) {
        pollMsg.hidden = false;
        pollMsg.textContent = "自动检测已暂停，付款完成后可点击支付状态旁的「刷新状态」。";
      }
      if (pollTimer) clearInterval(pollTimer);
      return;
    }
    if (!force) pollCount += 1;
    const queryPassword = getQueryPassword();
    try {
      const res = await fetch("/api/orders/check-payment", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ orderNo, queryPassword: queryPassword || undefined }),
      });
      const data = await res.json();
      if (!res.ok) return;
      if (statusEl) statusEl.textContent = data.paymentStatusLabel || data.paymentStatus;
      if (fulfillEl) fulfillEl.textContent = fulfillLabel(data.fulfillStatus);

      if (data.paymentStatus === "paid") {
        phase = data.fulfillStatus === "done" ? "done" : "fulfill";
        if (pollMsg) {
          pollMsg.hidden = false;
          if (data.fulfillStatus === "done" && data.deliverSecret) {
            pollMsg.textContent = "支付成功，发货完成。";
            showDeliver(data);
            if (pollTimer) clearInterval(pollTimer);
          } else if (data.fulfillStatus === "done" && !data.deliverSecret) {
            pollMsg.textContent =
              "支付与发货已完成。请前往顶部「历史订单」使用下单邮箱验证查看发货内容。";
            if (pollTimer) clearInterval(pollTimer);
          } else if (data.fulfillStatus === "error") {
            pollMsg.textContent = data.fulfillError || "发货异常，请联系客服或稍后在历史订单查看。";
            if (pollTimer) clearInterval(pollTimer);
          } else {
            pollMsg.textContent = "支付成功，正在提取发货内容…";
            pollCount = Math.min(pollCount, 2);
          }
        }
      }
    } catch {
      /* ignore transient */
    }
  }

  const open =
    root?.dataset.paymentStatus === "pending" ||
    root?.dataset.paymentStatus === "confirming" ||
    root?.dataset.paymentStatus === "paid";
  if (open) {
    refreshPayment(true);
    pollTimer = setInterval(() => refreshPayment(false), 2500);
  }

  document.querySelector("[data-testid=manual-refresh]")?.addEventListener("click", () => {
    pollCount = 0;
    refreshPayment(true);
  });

  document.querySelector("[data-testid=simulate-pay]")?.addEventListener("click", async () => {
    try {
      const res = await fetch("/api/dev/simulate-payment", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ orderNo }),
      });
      const data = await res.json();
      if (!res.ok) {
        if (pollMsg) {
          pollMsg.hidden = false;
          pollMsg.textContent = data.error || "模拟失败";
        }
        return;
      }
      pollCount = 0;
      phase = "fulfill";
      refreshPayment(true);
    } catch {
      /* ignore */
    }
  });

  const form = document.getElementById("txid-form") as HTMLFormElement | null;
  const txErr = document.getElementById("txid-error");
  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!form || !txErr) return;
    txErr.hidden = true;
    const txId = (form.elements.namedItem("txId") as HTMLInputElement).value.trim();
    const btn = form.querySelector("button[type=submit]") as HTMLButtonElement;
    btn.disabled = true;
    try {
      const res = await fetch("/api/orders/verify-tx", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ orderNo, txId }),
      });
      const data = await res.json();
      if (!res.ok) {
        txErr.textContent = data.error || "核对失败";
        txErr.hidden = false;
        return;
      }
      if (statusEl) statusEl.textContent = data.paymentStatusLabel || data.paymentStatus;
      if (data.paymentStatus === "paid") {
        pollCount = 0;
        phase = "fulfill";
        refreshPayment(true);
        return;
      }
      txErr.textContent = "尚未确认到账，请稍后再试";
      txErr.hidden = false;
    } catch {
      txErr.textContent = "网络异常";
      txErr.hidden = false;
    } finally {
      btn.disabled = false;
    }
  });
</script>

<style>
  .pay {
    max-width: 46rem;
    margin: 0 auto;
  }

  .pay-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .pay h1 {
    margin: 0;
    font-size: clamp(1.55rem, 3vw, 2rem);
    letter-spacing: -0.025em;
  }

  .lead {
    margin: 0.65rem 0 0;
    color: var(--muted-foreground);
    font-size: 0.92rem;
    line-height: 1.6;
  }

  .countdown-pill,
  .status-pill {
    display: inline-flex;
    align-items: center;
    padding: 0.35rem 0.78rem;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 600;
    white-space: nowrap;
    background: var(--magnetic-soft);
    color: var(--magnetic);
    border: 1px solid var(--magnetic-ring);
  }

  .status-pill.paid {
    background: #f0fdf4;
    color: #15803d;
    border-color: #bbf7d0;
  }

  .status-pill.expired {
    background: #fef2f2;
    color: #dc2626;
    border-color: #fecaca;
  }

  .expired-banner {
    margin: 1rem 0 0;
    padding: 0.85rem 1rem;
    border-radius: 0.85rem;
    background: #fef2f2;
    border: 1px solid #fecaca;
    color: #b42318;
    font-size: 0.88rem;
    line-height: 1.55;
  }

  .alipay-cta-box {
    margin-top: 1.25rem;
    padding: 1.15rem 1.25rem;
    border-radius: 1rem;
    border: 1px solid rgba(22, 119, 255, 0.24);
    background: linear-gradient(180deg, #f5f9ff 0%, #ffffff 100%);
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
