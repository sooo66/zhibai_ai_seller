---
import PageLayout from "../../layouts/PageLayout.astro";
import { getSessionUser } from "../../lib/auth";
import { expireOpenOrders, getOrderByNo, getProductById } from "../../lib/db";
import { env } from "../../lib/env";
import { getUsdtConfig, paymentStatusLabel } from "../../lib/payment";

export const prerender = false;

expireOpenOrders();

const { orderNo } = Astro.params;
const order = orderNo ? getOrderByNo(orderNo) : undefined;
if (!order) {
  return Astro.rewrite("/404");
}

const product = getProductById(order.product_id);
const fulfillType = product?.fulfill_type || "card";
const usdt = getUsdtConfig();
const payLabel = paymentStatusLabel(order.payment_status);
const isOpen =
  order.payment_status === "pending" || order.payment_status === "confirming";
const allowSimulate = env("ALLOW_PAYMENT_SIMULATE") === "1";
const sessionUser = getSessionUser(Astro.cookies);
const isOwnerSession =
  Boolean(sessionUser) &&
  sessionUser!.email.trim().toLowerCase() === order.email.trim().toLowerCase();
---

<PageLayout title={`付款 ${order.order_no} · Magfield`}>
  <section
    class="pay"
    data-testid="pay-page"
    data-order-no={order.order_no}
    data-expires-at={order.expires_at || ""}
    data-payment-status={order.payment_status}
    data-fulfill-type={fulfillType}
    data-email={order.email}
  >
    <h1>USDT 付款</h1>
    <p class="lead">
      请向下方地址转入<strong>精确应付金额</strong>（系统用金额自动匹配订单）。无需备注订单号；链上确认后自动发货。
    </p>

    {
      isOpen ? (
        <p class="countdown" data-testid="pay-countdown">计算剩余时间…</p>
      ) : order.payment_status === "expired" ? (
        <p class="expired-banner" data-testid="pay-expired">
          支付已过期。若已转账请联系客服并提供交易号，或重新下单。
        </p>
      ) : null
    }

    <div class="panel">
      <div class="row"><span>订单号</span><code data-testid="pay-order-no">{order.order_no}</code></div>
      <div class="row"><span>套餐</span><strong>{order.product_name}</strong></div>
      <div class="row"><span>接收邮箱</span><strong>{order.email}</strong></div>
      <div class="row value-row">
        <span>应付金额</span>
        <div class="value-actions">
          <strong data-testid="pay-usdt">{order.amount_usdt} USDT</strong>
          <button
            type="button"
            class="btn btn-ghost btn-sm"
            data-copy={String(order.amount_usdt)}
            data-testid="copy-amount"
          >
            复制金额
          </button>
        </div>
      </div>
      <div class="row"><span>参考人民币</span><strong>¥{order.amount_cny}</strong></div>
      <div class="row"><span>网络</span><strong>{usdt.network}</strong></div>
      <div class="row value-row">
        <span>收款地址</span>
        <div class="value-actions">
          <code class="break" data-testid="pay-address">{usdt.address}</code>
          <button
            type="button"
            class="btn btn-ghost btn-sm"
            data-copy={usdt.address}
            data-testid="copy-address"
          >
            复制地址
          </button>
        </div>
      </div>
      {
        order.expires_at ? (
          <div class="row">
            <span>支付截止</span>
            <strong data-testid="pay-expires">{order.expires_at}</strong>
          </div>
        ) : null
      }
      <div class="row"><span>支付状态</span><strong data-testid="pay-status">{payLabel}</strong></div>
      <div class="row"><span>发货状态</span><strong data-testid="fulfill-status">—</strong></div>
    </div>

    {
      (product?.account_warning || product?.summary || product?.description) ? (
        <div class="policy-remind" data-testid="pay-policy-remind">
          <div class="policy-remind-summary">
            <strong>购前与售后提示：</strong>
            {product?.account_warning || product?.summary}
          </div>
          {product?.description ? (
            <details class="policy-remind-details">
              <summary>展开查看完整商品说明与售后政策</summary>
              <pre class="policy-remind-full">{product.description}</pre>
            </details>
          ) : null}
        </div>
      ) : null
    }

    <div class="hint">
      金额必须与页面显示的 <code data-testid="pay-usdt-exact">{order.amount_usdt}</code> USDT
      完全一致（含小数），以便自动匹配。请勿多转或少转。
    </div>
    <p id="copy-toast" class="toast" hidden data-testid="copy-toast">已复制</p>
    <p id="pay-poll-msg" class="poll-msg" data-testid="pay-poll-msg" hidden></p>

    <div id="deliver-panel" class="deliver" hidden data-testid="deliver-panel">
      <h2 data-testid="deliver-title">请立即复制 / 截图保存</h2>
      <p class="deliver-lead" data-testid="deliver-lead"></p>
      <div class="cred-card" data-testid="cred-card">
        <div class="cred-row"><span>订单号</span><code data-testid="cred-order-no">{order.order_no}</code></div>
        <div class="cred-row"><span>接收邮箱</span><strong data-testid="cred-email">{order.email}</strong></div>
        <div class="cred-row">
          <span>归档状态</span>
          <strong data-testid="cred-password">
            {isOwnerSession ? "已绑定当前轻账户，随时可在历史订单查看" : "请前往「历史订单」用邮箱验证码查看"}
          </strong>
        </div>
        <div class="cred-secret">
          <div class="muted" data-testid="secret-label">发货内容</div>
          <pre data-testid="deliver-secret"></pre>
        </div>
      </div>
      <p class="deliver-note" data-testid="deliver-note">
        请立即复制或截图保存。后续可随时到「历史订单」通过邮箱验证码找回全部订单与发货内容。
      </p>
    </div>

    {
      isOpen ? (
        <div class="txid-box" data-testid="txid-box">
          <h2>未自动到账？粘贴交易号</h2>
          <p class="txid-help">从钱包或交易所复制 TxID / 交易哈希，我们会在链上验真后发货。</p>
          <form id="txid-form" data-testid="txid-form">
            <input
              name="txId"
              required
              minlength="16"
              placeholder="64 位交易哈希"
              data-testid="txid-input"
            />
            <button type="submit" class="btn btn-primary" data-testid="txid-submit">
              提交验真
            </button>
          </form>
          <p id="txid-error" class="error" hidden data-testid="txid-error"></p>
        </div>
      ) : null
    }

    {
      allowSimulate && isOpen ? (
        <div class="sim-box" data-testid="simulate-box">
          <button type="button" class="btn btn-ghost" data-testid="simulate-pay">
            模拟支付（开发）
          </button>
        </div>
      ) : null
    }

    <div class="actions">
      <button type="button" class="btn btn-ghost" data-testid="manual-refresh">手动刷新状态</button>
      <a class="btn btn-primary" href="/orders" data-testid="goto-orders">历史订单</a>
      <a class="btn btn-ghost" href="/#subscribe">返回选购</a>
    </div>
  </section>
</PageLayout>

<script>
  const root = document.querySelector("[data-testid=pay-page]") as HTMLElement | null;
  const toast = document.getElementById("copy-toast");
  const countdown = document.querySelector("[data-testid=pay-countdown]");
  const statusEl = document.querySelector("[data-testid=pay-status]");
  const fulfillEl = document.querySelector("[data-testid=fulfill-status]");
  const pollMsg = document.getElementById("pay-poll-msg");
  const deliverPanel = document.getElementById("deliver-panel");
  const orderNo = root?.dataset.orderNo || "";
  const fulfillType = root?.dataset.fulfillType || "card";
  const storageKey = `mf_qp_${orderNo}`;

  function getQueryPassword() {
    try {
      return sessionStorage.getItem(storageKey) || "";
    } catch {
      return "";
    }
  }

  function fulfillLabel(s: string) {
    if (s === "done") return "已发货";
    if (s === "processing") return "提取中";
    if (s === "error") return "发货异常";
    if (s === "none") return "待支付后发货";
    return s || "—";
  }

  root?.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const text = btn.dataset.copy || "";
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        const ta = document.createElement("textarea");
        ta.value = text;
        document.body.appendChild(ta);
        ta.select();
        document.execCommand("copy");
        ta.remove();
      }
      if (toast) {
        toast.hidden = false;
        toast.textContent = "已复制";
        setTimeout(() => {
          toast.hidden = true;
        }, 1500);
      }
    });
  });

  const expiresAt = root?.dataset.expiresAt;
  if (countdown && expiresAt) {
    const tick = () => {
      const end = Date.parse(expiresAt.includes("T") ? expiresAt : expiresAt.replace(" ", "T") + "Z");
      const left = end - Date.now();
      if (!Number.isFinite(end) || left <= 0) {
        countdown.textContent = "支付窗口已结束";
        return;
      }
      const m = Math.floor(left / 60000);
      const s = Math.floor((left % 60000) / 1000);
      countdown.textContent = `剩余支付时间 ${m}:${String(s).padStart(2, "0")}`;
    };
    tick();
    setInterval(tick, 1000);
  }

  let pollCount = 0;
  const MAX_AUTO_POLLS = 6;
  let pollTimer: ReturnType<typeof setInterval> | undefined;
  let phase: "pay" | "fulfill" | "done" = "pay";

  function showDeliver(data: {
    deliverSecret?: string | null;
    email?: string;
  }) {
    if (!deliverPanel) return;
    deliverPanel.hidden = false;
    const lead = document.querySelector("[data-testid=deliver-lead]");
    const note = document.querySelector("[data-testid=deliver-note]");
    const secretLabel = document.querySelector("[data-testid=secret-label]");
    const secretEl = document.querySelector("[data-testid=deliver-secret]");
    if (lead) {
      lead.textContent =
        fulfillType === "account"
          ? "以下为成品账号资料，请妥善保存。"
          : fulfillType === "manual"
            ? "订单已支付并生成人工代充记录，请携带订单号联系客服协助完成自有账号代充。"
            : "以下为充值卡密，请按说明前往充值站充到你自己的账号。";
    }
    if (secretLabel) {
      secretLabel.textContent =
        fulfillType === "account"
          ? "成品账号资料"
          : fulfillType === "manual"
            ? "人工代充凭据"
            : "卡密 / 充值内容";
    }
    if (secretEl) secretEl.textContent = data.deliverSecret || "";
    if (note) {
      note.textContent =
        "请立即复制或截图。随时可到「历史订单」用当前已验证邮箱找回全部记录。";
    }
  }

  async function refreshPayment(force = false) {
    if (!orderNo) return;
    if (!force && pollCount >= MAX_AUTO_POLLS && phase !== "fulfill") {
      if (pollMsg) {
        pollMsg.hidden = false;
        pollMsg.textContent = "自动检测已暂停，可点击「手动刷新状态」。";
      }
      if (pollTimer) clearInterval(pollTimer);
      return;
    }
    if (!force) pollCount += 1;
    const queryPassword = getQueryPassword();
    try {
      const res = await fetch("/api/orders/check-payment", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ orderNo, queryPassword: queryPassword || undefined }),
      });
      const data = await res.json();
      if (!res.ok) return;
      if (statusEl) statusEl.textContent = data.paymentStatusLabel || data.paymentStatus;
      if (fulfillEl) fulfillEl.textContent = fulfillLabel(data.fulfillStatus);

      if (data.paymentStatus === "paid") {
        phase = data.fulfillStatus === "done" ? "done" : "fulfill";
        if (pollMsg) {
          pollMsg.hidden = false;
          if (data.fulfillStatus === "done" && data.deliverSecret) {
            pollMsg.textContent = "支付成功，发货完成。";
            showDeliver(data);
            if (pollTimer) clearInterval(pollTimer);
          } else if (data.fulfillStatus === "done" && !data.deliverSecret) {
            pollMsg.textContent =
              "支付与发货已完成。请到「历史订单」使用下单邮箱收验证码查看发货内容。";
            if (pollTimer) clearInterval(pollTimer);
          } else if (data.fulfillStatus === "error") {
            pollMsg.textContent = data.fulfillError || "发货异常，请联系客服或稍后在历史订单查看。";
            if (pollTimer) clearInterval(pollTimer);
          } else {
            pollMsg.textContent = "支付成功，正在提取发货内容…";
            pollCount = Math.min(pollCount, 2);
          }
        }
      }
    } catch {
      /* ignore transient */
    }
  }

  const open =
    root?.dataset.paymentStatus === "pending" ||
    root?.dataset.paymentStatus === "confirming" ||
    root?.dataset.paymentStatus === "paid";
  if (open) {
    refreshPayment(true);
    pollTimer = setInterval(() => refreshPayment(false), 2500);
  }

  document.querySelector("[data-testid=manual-refresh]")?.addEventListener("click", () => {
    pollCount = 0;
    refreshPayment(true);
  });

  document.querySelector("[data-testid=simulate-pay]")?.addEventListener("click", async () => {
    try {
      const res = await fetch("/api/dev/simulate-payment", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ orderNo }),
      });
      const data = await res.json();
      if (!res.ok) {
        if (pollMsg) {
          pollMsg.hidden = false;
          pollMsg.textContent = data.error || "模拟失败";
        }
        return;
      }
      pollCount = 0;
      phase = "fulfill";
      refreshPayment(true);
    } catch {
      /* ignore */
    }
  });

  const form = document.getElementById("txid-form") as HTMLFormElement | null;
  const txErr = document.getElementById("txid-error");
  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!form || !txErr) return;
    txErr.hidden = true;
    const txId = (form.elements.namedItem("txId") as HTMLInputElement).value.trim();
    const btn = form.querySelector("button[type=submit]") as HTMLButtonElement;
    btn.disabled = true;
    try {
      const res = await fetch("/api/orders/verify-tx", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ orderNo, txId }),
      });
      const data = await res.json();
      if (!res.ok) {
        txErr.textContent = data.error || "验真失败";
        txErr.hidden = false;
        return;
      }
      if (statusEl) statusEl.textContent = data.paymentStatusLabel || data.paymentStatus;
      if (data.paymentStatus === "paid") {
        pollCount = 0;
        phase = "fulfill";
        refreshPayment(true);
        return;
      }
      txErr.textContent = "尚未确认到账，请稍后再试（可能仍在上链）";
      txErr.hidden = false;
    } catch {
      txErr.textContent = "网络异常";
      txErr.hidden = false;
    } finally {
      btn.disabled = false;
    }
  });
</script>

<style>
  .pay h1 {
    margin: 0;
    font-size: clamp(1.6rem, 3vw, 2.2rem);
  }

  .lead {
    margin-top: 0.75rem;
    color: var(--muted-foreground);
    line-height: 1.6;
  }

  .countdown {
    margin: 1rem 0 0;
    color: var(--foreground);
    font-size: 0.95rem;
    font-weight: 600;
  }

  .expired-banner {
    margin: 1rem 0 0;
    color: #b42318;
    font-size: 0.95rem;
  }

  .panel {
    margin-top: 1.25rem;
    border: 1px solid var(--border);
    border-radius: 1rem;
    background: var(--surface);
    padding: 1.25rem 1.4rem;
    display: grid;
    gap: 0.9rem;
  }

  .row {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.75rem;
  }

  .row:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  @media (min-width: 640px) {
    .row {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .row span {
    color: var(--muted-foreground);
    font-size: 0.9rem;
  }

  .value-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
    justify-content: flex-end;
  }

  code {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.9rem;
  }

  .break {
    word-break: break-all;
  }

  .policy-remind {
    margin-top: 1rem;
    padding: 0.9rem 1.05rem;
    border-radius: 0.9rem;
    border: 1px solid var(--amber-border);
    background: var(--amber-bg);
    color: var(--amber-text);
    font-size: 0.86rem;
    line-height: 1.55;
  }

  .policy-remind-details {
    margin-top: 0.6rem;
    padding-top: 0.55rem;
    border-top: 1px dashed var(--amber-border);
  }

  .policy-remind-details summary {
    cursor: pointer;
    font-weight: 600;
    font-size: 0.82rem;
  }

  .policy-remind-full {
    margin: 0.6rem 0 0;
    padding: 0.75rem 0.85rem;
    border-radius: 0.65rem;
    background: rgba(255, 255, 255, 0.75);
    color: var(--foreground);
    font-family: inherit;
    font-size: 0.8rem;
    line-height: 1.6;
    white-space: pre-wrap;
    word-break: break-word;
    max-height: 20rem;
    overflow-y: auto;
  }

  .hint {
    margin-top: 0.85rem;
    padding: 1rem 1.1rem;
    border-radius: 0.9rem;
    border: 1px solid var(--magnetic-ring);
    background: var(--magnetic-soft);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .toast {
    margin-top: 0.75rem;
    color: #067647;
    font-size: 0.9rem;
  }

  .poll-msg {
    margin-top: 0.75rem;
    color: #067647;
    font-size: 0.92rem;
  }

  .deliver {
    margin-top: 1.25rem;
    padding: 1.2rem 1.3rem;
    border-radius: 1rem;
    border: 1px solid #b45309;
    background: #fffbeb;
  }

  .deliver h2 {
    margin: 0;
    font-size: 1.1rem;
    color: #9a3412;
  }

  .deliver-lead {
    margin: 0.45rem 0 0.9rem;
    font-size: 0.9rem;
    color: #92400e;
  }

  .cred-card {
    display: grid;
    gap: 0.65rem;
    padding: 1rem;
    border-radius: 0.85rem;
    background: #fff;
    border: 1px solid #fcd34d;
  }

  .cred-row {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
    font-size: 0.92rem;
  }

  .cred-row span {
    color: var(--muted-foreground);
  }

  .cred-secret {
    margin-top: 0.25rem;
    padding-top: 0.65rem;
    border-top: 1px dashed #fcd34d;
  }

  .cred-secret .muted {
    color: var(--muted-foreground);
    font-size: 0.85rem;
  }

  .cred-secret pre {
    margin: 0.45rem 0 0;
    white-space: pre-wrap;
    word-break: break-all;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.92rem;
  }

  .deliver-note {
    margin: 0.85rem 0 0;
    font-size: 0.85rem;
    color: #92400e;
  }

  .txid-box,
  .sim-box {
    margin-top: 1.5rem;
    border: 1px solid var(--border);
    border-radius: 1rem;
    padding: 1.1rem 1.2rem;
    background: var(--surface);
  }

  .txid-box h2 {
    margin: 0;
    font-size: 1.05rem;
  }

  .txid-help {
    margin: 0.45rem 0 0.9rem;
    color: var(--muted-foreground);
    font-size: 0.88rem;
  }

  #txid-form {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  #txid-form input {
    flex: 1 1 14rem;
    border: 1px solid var(--border);
    border-radius: 0.7rem;
    background: var(--surface);
    color: var(--foreground);
    padding: 0.7rem 0.85rem;
  }

  .error {
    margin: 0.6rem 0 0;
    color: #b42318;
    font-size: 0.9rem;
  }

  .actions {
    margin-top: 1.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>
