---
import PageLayout from "../../layouts/PageLayout.astro";
import { isAdminAuthed } from "../../lib/admin-auth";
import { listAllProducts, listOrders } from "../../lib/db";
import { daituConnect, isDaituDryRun } from "../../lib/daitu";
import { listEnabledPaymentProviders, listPaymentProviders } from "../../lib/payments";

export const prerender = false;

if (!isAdminAuthed(Astro.cookies)) {
  return Astro.redirect("/admin/login");
}

const products = listAllProducts();
const orders = listOrders(80);
const dryRun = isDaituDryRun();
const providers = listPaymentProviders();
const enabledProviders = listEnabledPaymentProviders();

let balance: number | null = null;
let shopName = "";
try {
  const connect = await daituConnect();
  const data = (connect.data || {}) as { balance?: number; username?: string; shopName?: string };
  balance = typeof data.balance === "number" ? data.balance : null;
  shopName = data.shopName || data.username || "";
} catch {
  balance = null;
}

const productsJson = JSON.stringify(products);
const ordersJson = JSON.stringify(orders);
const exceptionCount = orders.filter(
  (o) =>
    o.payment_status === "manual_review" ||
    o.fulfill_status === "error" ||
    o.payment_status === "expired",
).length;
---

<PageLayout title="管理后台 · Magfield">
  <section class="admin" data-testid="admin-dashboard">
    <div class="admin-head">
      <div>
        <h1>管理后台</h1>
        <p class="meta">
          货源余额：{balance === null ? "未知" : `¥${balance}`}
          {shopName ? ` · ${shopName}` : ""}
          {dryRun ? " · DRY_RUN 开启（不会真实扣带土余额）" : ""}
          {" · 支付通道：" +
            enabledProviders.map((p) => p.label).join("、") +
            (providers.some((p) => !p.enabled) ? "（含未启用占位）" : "")}
        </p>
      </div>
      <div class="head-actions">
        <button id="sync-16688-btn" class="btn btn-primary btn-sm" type="button" data-testid="admin-sync-16688">
          批量同步到 16688
        </button>
        <button id="logout-btn" class="btn btn-ghost btn-sm" type="button" data-testid="admin-logout">
          退出
        </button>
      </div>
    </div>

    <p id="admin-msg" class="msg" hidden data-testid="admin-msg"></p>

    <h2>商品（至尊拿货价 × 1.15 与 16688 映射）</h2>
    <div class="table-wrap">
      <table data-testid="admin-products">
        <thead>
          <tr>
            <th>名称</th>
            <th>拿货价</th>
            <th>售价</th>
            <th>16688 商品编号</th>
            <th>16688 直达付款链接</th>
            <th>上架</th>
            <th>操作</th>
          </tr>
        </thead>
        <tbody id="products-body"></tbody>
      </table>
    </div>

    <h2>订单 <span class="meta" data-testid="exception-count">异常 {exceptionCount}</span></h2>
    <div class="table-wrap">
      <table data-testid="admin-orders">
        <thead>
          <tr>
            <th>订单号</th>
            <th>套餐</th>
            <th>邮箱</th>
            <th>渠道 / 金额</th>
            <th>支付</th>
            <th>凭据 / Tx</th>
            <th>履约</th>
            <th>操作</th>
          </tr>
        </thead>
        <tbody id="orders-body"></tbody>
      </table>
    </div>
  </section>
</PageLayout>

<script define:vars={{ productsJson, ordersJson }}>
  const products = JSON.parse(productsJson);
  const orders = JSON.parse(ordersJson);
  const msg = document.getElementById("admin-msg");
  const productsBody = document.getElementById("products-body");
  const ordersBody = document.getElementById("orders-body");
  const syncBtn = document.getElementById("sync-16688-btn");

  function esc(s) {
    return String(s ?? "")
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;");
  }

  function showMsg(text) {
    if (!msg) return;
    msg.textContent = text;
    msg.hidden = !text;
  }

  function renderProducts() {
    if (!productsBody) return;
    productsBody.innerHTML = products
      .map(
        (p) => `
      <tr data-id="${p.id}">
        <td>
          <strong>${esc(p.name)}</strong>
          <div class="sub-code"><code>${esc(p.daitu_code)}</code></div>
        </td>
        <td class="tabular">¥${p.cost_cny || 0}</td>
        <td>
          <input type="number" class="cell-input price-input" value="${p.price_cny}" data-id="${p.id}" />
        </td>
        <td>
          <input type="text" class="cell-input goods-no-input" placeholder="G10001" value="${esc(p.shop16688_goods_no || "")}" data-id="${p.id}" />
        </td>
        <td>
          <input type="url" class="cell-input url-input" placeholder="https://www.16688.com.cn/..." value="${esc(p.shop16688_url || "")}" data-id="${p.id}" />
        </td>
        <td>${p.visible ? "是" : "否"}</td>
        <td>
          <button type="button" class="toggle-btn" data-id="${p.id}" data-visible="${p.visible}">
            ${p.visible ? "隐藏" : "上架"}
          </button>
        </td>
      </tr>`,
      )
      .join("");
  }

  function renderOrders() {
    if (!ordersBody) return;
    ordersBody.innerHTML = orders
      .map((o) => {
        const bad =
          o.payment_status === "manual_review" ||
          o.fulfill_status === "error" ||
          o.payment_status === "expired";
        const retry =
          o.payment_status === "paid" || o.payment_status === "manual_review"
            ? `<button type="button" class="retry-btn" data-order="${esc(o.order_no)}" data-testid="retry-${esc(o.order_no)}">重试履约</button>`
            : "";
        const payAmt =
          o.payment_channel === "alipay_16688"
            ? `支付宝 ¥${o.amount_cny}`
            : `${o.amount_usdt} USDT`;
        const ref = o.shop16688_trade_no || o.payment_tx_id || "-";
        return `
      <tr data-order="${esc(o.order_no)}" class="${bad ? "row-bad" : ""}">
        <td><code>${esc(o.order_no)}</code></td>
        <td>${esc(o.product_name)}</td>
        <td>${esc(o.email)}</td>
        <td class="tabular">${esc(payAmt)}</td>
        <td data-testid="pay-${esc(o.order_no)}">${esc(o.payment_status)}</td>
        <td><code class="tx">${esc(ref)}</code></td>
        <td data-testid="fulfill-${esc(o.order_no)}">${esc(o.fulfill_status)}${o.fulfill_error ? ` / ${esc(o.fulfill_error)}` : ""}</td>
        <td class="ops">
          <button type="button" class="confirm-btn" data-order="${esc(o.order_no)}">确认到账并履约</button>
          ${retry}
        </td>
      </tr>`;
      })
      .join("");
  }

  renderProducts();
  renderOrders();

  syncBtn?.addEventListener("click", async () => {
    syncBtn.setAttribute("disabled", "true");
    syncBtn.textContent = "同步中…";
    showMsg("正在调用 16688 OpenAPI 批量上传/更新在售商品…");
    try {
      const res = await fetch("/api/admin/sync-16688", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: "{}",
      });
      const data = await res.json();
      if (!res.ok || !data.ok) {
        showMsg(`16688 同步提示：${data.message || data.error || "请求失败"}`);
      } else {
        showMsg(data.message || "同步完成");
        setTimeout(() => location.reload(), 1200);
      }
    } catch {
      showMsg("网络异常，16688 同步请求失败");
    } finally {
      syncBtn.removeAttribute("disabled");
      syncBtn.textContent = "批量同步到 16688";
    }
  });

  document.getElementById("logout-btn")?.addEventListener("click", async () => {
    await fetch("/api/admin/logout", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: "{}",
    });
    location.href = "/admin/login";
  });

  productsBody?.addEventListener("click", async (e) => {
    const t = e.target;
    if (!(t instanceof HTMLElement) || !t.classList.contains("toggle-btn")) return;
    const id = Number(t.dataset.id);
    const visible = !(Number(t.dataset.visible) === 1);
    const res = await fetch("/api/admin/products", {
      method: "PATCH",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ id, visible }),
    });
    const data = await res.json();
    if (!res.ok) {
      showMsg(data.error || "更新失败");
      return;
    }
    location.reload();
  });

  productsBody?.addEventListener("change", async (e) => {
    const t = e.target;
    if (!(t instanceof HTMLInputElement)) return;
    const id = Number(t.dataset.id);
    if (!id) return;
    let payload = null;
    if (t.classList.contains("price-input")) {
      payload = { id, price_cny: Number(t.value) };
    } else if (t.classList.contains("goods-no-input")) {
      payload = { id, shop16688_goods_no: t.value.trim() };
    } else if (t.classList.contains("url-input")) {
      payload = { id, shop16688_url: t.value.trim() };
    }
    if (!payload) return;

    const res = await fetch("/api/admin/products", {
      method: "PATCH",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(payload),
    });
    const data = await res.json();
    if (!res.ok) {
      showMsg(data.error || "保存失败");
      return;
    }
    showMsg("商品配置已保存");
  });

  ordersBody?.addEventListener("click", async (e) => {
    const t = e.target;
    if (!(t instanceof HTMLElement)) return;
    const orderNo = t.dataset.order;
    if (!orderNo) return;

    if (t.classList.contains("confirm-btn")) {
      t.setAttribute("disabled", "true");
      const res = await fetch("/api/admin/orders/confirm", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ orderNo }),
      });
      const data = await res.json();
      if (!res.ok) {
        showMsg(data.error || "确认失败");
        t.removeAttribute("disabled");
        return;
      }
      showMsg(`订单 ${orderNo} 已确认并尝试履约`);
      location.reload();
      return;
    }

    if (t.classList.contains("retry-btn")) {
      t.setAttribute("disabled", "true");
      const res = await fetch("/api/admin/orders/retry-fulfill", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ orderNo }),
      });
      const data = await res.json();
      if (!res.ok) {
        showMsg(data.error || "重试失败");
        t.removeAttribute("disabled");
        return;
      }
      showMsg(`订单 ${orderNo} 已重试履约`);
      location.reload();
    }
  });
</script>

<style>
  .admin-head {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: flex-start;
    flex-wrap: wrap;
  }

  .head-actions {
    display: flex;
    gap: 0.55rem;
    align-items: center;
  }

  h1 {
    margin: 0;
    font-size: 1.75rem;
  }

  h2 {
    margin: 2rem 0 0.85rem;
    font-size: 1.15rem;
  }

  .meta {
    margin: 0.4rem 0 0;
    color: var(--muted-foreground);
    font-size: 0.9rem;
  }

  .msg {
    margin-top: 1rem;
    padding: 0.75rem 1rem;
    border-radius: 0.75rem;
    border: 1px solid var(--magnetic-ring);
    background: var(--magnetic-soft);
    color: var(--foreground);
    font-size: 0.9rem;
  }

  .table-wrap {
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: 1rem;
    background: var(--surface);
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.86rem;
  }

  th,
  td {
    text-align: left;
    padding: 0.7rem 0.85rem;
    border-top: 1px solid var(--border);
    vertical-align: middle;
  }

  thead th {
    border-top: none;
    color: var(--muted-foreground);
    font-weight: 500;
    white-space: nowrap;
  }

  code {
    font-family: var(--font-mono);
    font-size: 0.76rem;
  }

  .sub-code {
    margin-top: 0.15rem;
    color: var(--muted-foreground);
  }

  .cell-input {
    border: 1px solid var(--border-strong);
    border-radius: 0.45rem;
    background: var(--background);
    color: var(--foreground);
    padding: 0.35rem 0.5rem;
    font-size: 0.82rem;
  }

  .price-input {
    width: 5.2rem;
  }

  .goods-no-input {
    width: 6.5rem;
    font-family: var(--font-mono);
  }

  .url-input {
    width: 13rem;
  }

  .toggle-btn,
  .confirm-btn,
  .retry-btn {
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    background: var(--surface);
    color: var(--foreground);
    padding: 0.3rem 0.72rem;
    font-size: 0.75rem;
    cursor: pointer;
    white-space: nowrap;
  }

  .confirm-btn {
    background: var(--magnetic);
    border-color: transparent;
    color: #fff;
  }

  .ops {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .row-bad {
    background: #fef2f2;
  }

  .tx {
    max-width: 7.5rem;
    display: inline-block;
    overflow: hidden;
    text-overflow: ellipsis;
  }
</style>
