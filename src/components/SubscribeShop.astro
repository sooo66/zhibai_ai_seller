---
import { getSessionUser } from "../lib/auth";
import { listVisibleProducts } from "../lib/db";
import { getDaituSyncSnapshot } from "../lib/daitu-stock";
import { groupProductsByFamily } from "../lib/product-families";
import BrandIcon from "./BrandIcon.astro";

const products = listVisibleProducts();
const daituSnap = await getDaituSyncSnapshot();
const families = groupProductsByFamily(
  products,
  daituSnap.stockByCode,
  daituSnap.descriptionByCode,
);
const sessionUser = getSessionUser(Astro.cookies);
const familiesJson = JSON.stringify(families);
const firstSelectable =
  families.find((f) => f.plans.some((p) => p.inStock))?.id ?? families[0]?.id ?? "";
---

<section
  id="subscribe"
  class="shop"
  data-testid="subscribe-shop"
  data-families={familiesJson}
  data-user-email={sessionUser?.email || ""}
>
  {
    families.length === 0 ? (
      <p class="empty" data-testid="catalog-empty">
        暂无可购会员，请稍后再来。
      </p>
    ) : (
      <>
        <div class="section-bar">
          <span class="section-label">选择订阅服务</span>
          <span class="section-meta">点击品牌切换规格与购前说明 · 实时同步库存</span>
        </div>

        <div class="family-grid">
          {families.map((f) => (
            <button
              type="button"
              class:list={[
                "family-card",
                { selected: f.id === firstSelectable, "is-oos": !f.inStock },
              ]}
              data-family-id={f.id}
              data-testid={`family-${f.id}`}
              aria-pressed={f.id === firstSelectable ? "true" : "false"}
              aria-label={`${f.vendor} ${f.productLabel}${!f.inStock ? "（已售罄）" : ""}`}
            >
              <div class="family-card-top">
                <BrandIcon id={f.id} size={22} />
                {!f.inStock ? (
                  <span class="oos-badge">已售罄</span>
                ) : (
                  <span class="select-dot" aria-hidden="true">
                    <svg viewBox="0 0 12 12" width="10" height="10" fill="none">
                      <path
                        d="M2.5 6.2 5 8.6 9.5 3.6"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </span>
                )}
              </div>
              <div class="family-card-bottom">
                <span class="family-vendor">{f.vendor}</span>
                <span class="family-name">{f.productLabel}</span>
                <span class="family-price tabular">
                  ¥{f.fromPrice} 起
                </span>
              </div>
            </button>
          ))}
        </div>

        <!-- Integrated Equal-Height Plan Details, Pre-purchase Notice & Checkout Panel -->
        <aside
          class="workbench"
          data-testid="checkout-bar"
          data-visible="true"
        >
          <div class="workbench-left">
            <div class="workbench-left-top">
              <div class="plan-header">
                <div class="plan-heading-row">
                  <h2 class="checkout-title tabular" data-testid="checkout-title">—</h2>
                  <span class="type-badge" data-testid="plan-type-badge">卡密直充</span>
                </div>
                <p class="checkout-hint" data-testid="checkout-hint">
                  付款后发放卡密 · 自助充到你自己的账号
                </p>
              </div>

              <div class="plan-selector">
                <span class="sub-label">套餐规格</span>
                <div class="plan-pills" data-testid="plan-pills" role="group" aria-label="选择套餐"></div>
              </div>
            </div>

            <div class="notice-card" data-testid="pre-purchase-notice">
              <div class="notice-head">
                <span class="notice-title">购前须知与质保边界</span>
                <button
                  type="button"
                  class="policy-link"
                  id="open-policy-btn"
                  data-testid="open-policy-btn"
                >
                  查看完整售后政策 →
                </button>
              </div>

              <dl class="notice-grid">
                <div class="notice-row">
                  <dt>交付方式</dt>
                  <dd data-testid="notice-delivery">—</dd>
                </div>
                <div class="notice-row">
                  <dt>账号要求</dt>
                  <dd data-testid="notice-requirement">—</dd>
                </div>
                <div class="notice-row">
                  <dt>质保范围</dt>
                  <dd data-testid="notice-warranty">—</dd>
                </div>
              </dl>

              <p class="account-warning" data-testid="account-warning" hidden></p>

              <button
                type="button"
                class="policy-red-alert"
                id="notice-red-policy-btn"
                data-testid="policy-red-alert"
              >
                下单前请详细阅读完整售后政策
              </button>
            </div>
          </div>

          <div class="workbench-right">
            <div class="checkout-card">
              <div class="checkout-card-head">
                <span class="sub-label">订单结算</span>
                <span class="pay-method-tag">USDT · TRC-20</span>
              </div>

              <div class="order-summary-strip">
                <span class="summary-plan" data-testid="summary-plan-name">—</span>
                <strong class="summary-price tabular" data-testid="summary-plan-price">—</strong>
              </div>

              <form class="checkout-form" id="checkout-form" data-testid="checkout-form">
                <div class="checkout-fields">
                  <!-- Verified cached-session state -->
                  <div
                    class="verified-account-box"
                    id="auth-signed-box"
                    data-testid="verified-account-box"
                    hidden={!sessionUser}
                  >
                    <div class="verified-top">
                      <span class="verified-badge">
                        <span class="verified-dot" aria-hidden="true"></span>
                        邮箱已验证 · 自动保持登录
                      </span>
                      <button
                        type="button"
                        class="switch-account-btn"
                        id="switch-account-btn"
                        data-testid="switch-account-btn"
                      >
                        切换邮箱
                      </button>
                    </div>
                    <div class="verified-email" id="verified-email-text" data-testid="verified-email">
                      {sessionUser?.email || ""}
                    </div>
                    <p class="verified-desc">
                      订单与卡密将自动归档至该邮箱的「历史订单」，当前设备 90 天内无需重复验证。
                    </p>
                  </div>

                  <!-- Unverified OTP verification state -->
                  <div
                    class="otp-auth-box"
                    id="auth-otp-box"
                    data-testid="otp-auth-box"
                    hidden={Boolean(sessionUser)}
                  >
                    <div class="field">
                      <div class="field-label-row">
                        <label for="checkout-email">验证邮箱</label>
                        <span class="field-hint">用于接收发货备份与历史查单</span>
                      </div>
                      <input
                        id="checkout-email"
                        type="email"
                        name="email"
                        placeholder="you@example.com"
                        autocomplete="email"
                        data-testid="checkout-email"
                      />
                    </div>

                    <div class="field">
                      <div class="field-label-row">
                        <label for="checkout-captcha">人机验证</label>
                        <span class="field-hint">点击图片可换一张</span>
                      </div>
                      <div class="captcha-row">
                        <input
                          id="checkout-captcha"
                          type="text"
                          name="captchaCode"
                          maxlength="4"
                          placeholder="输入右侧 4 位字符"
                          autocomplete="off"
                          spellcheck="false"
                          data-testid="checkout-captcha"
                        />
                        <button
                          type="button"
                          class="captcha-img-btn"
                          id="checkout-captcha-refresh"
                          title="点击刷新图形验证码"
                          aria-label="刷新图形验证码"
                          data-testid="checkout-captcha-refresh"
                        >
                          <img
                            id="checkout-captcha-img"
                            alt="图形验证码"
                            width="118"
                            height="40"
                          />
                        </button>
                      </div>
                    </div>

                    <div class="field">
                      <div class="field-label-row">
                        <label for="checkout-otp">邮箱验证码</label>
                        <span class="field-hint">验证一次，90 天免重验</span>
                      </div>
                      <div class="email-otp-row">
                        <input
                          id="checkout-otp"
                          type="text"
                          name="otpCode"
                          inputmode="numeric"
                          maxlength="6"
                          pattern="[0-9]{6}"
                          placeholder="6 位数字验证码"
                          autocomplete="one-time-code"
                          spellcheck="false"
                          data-testid="checkout-otp"
                        />
                        <button
                          type="button"
                          class="btn btn-ghost send-otp-btn tabular"
                          id="send-otp-btn"
                          data-testid="send-otp-btn"
                        >
                          获取验证码
                        </button>
                      </div>
                    </div>

                    <p class="otp-status" id="otp-status" hidden data-testid="otp-status"></p>
                  </div>

                  <p class="checkout-error" id="checkout-error" hidden data-testid="checkout-error"></p>
                </div>

                <div class="checkout-actions">
                  <button
                    type="submit"
                    class="btn btn-primary checkout-submit tabular"
                    data-testid="checkout-submit"
                  >
                    继续
                  </button>

                  <p class="consent-note">
                    点击继续即代表已阅读并同意左侧该方案的购前须知与售后政策。
                  </p>
                </div>
              </form>
            </div>
          </div>
        </aside>

        <!-- Full Policy Slide-over Modal -->
        <div
          class="policy-backdrop"
          id="policy-modal"
          hidden
          role="dialog"
          aria-modal="true"
          aria-labelledby="policy-modal-title"
          data-testid="policy-modal"
        >
          <div class="policy-sheet">
            <div class="policy-sheet-head">
              <div>
                <p class="policy-kicker">购前说明与售后政策</p>
                <h3 id="policy-modal-title" data-testid="policy-modal-title">—</h3>
              </div>
              <button
                type="button"
                class="policy-close"
                id="close-policy-btn"
                aria-label="关闭说明"
              >
                ✕
              </button>
            </div>
            <div class="policy-sheet-body">
              <div class="policy-warning-box" id="policy-modal-warning" hidden></div>
              <div class="policy-section-label" id="policy-modal-official-label" hidden>
                完整商品说明与售后政策
              </div>
              <div class="policy-official-box" id="policy-modal-official" hidden></div>
              <div class="policy-section-label">平台交易与客服说明</div>
              <ul class="policy-list" id="policy-modal-list"></ul>
            </div>
            <div class="policy-sheet-foot">
              <button type="button" class="btn btn-primary btn-sm" id="confirm-policy-btn">
                我已了解
              </button>
            </div>
          </div>
        </div>
      </>
    )
  }
</section>

<script>
  type PlanNotice = {
    delivery: string;
    requirement: string;
    warranty: string;
    warning: string;
    officialPolicyText: string;
    policyBullets: string[];
  };

  type FamilyPlan = {
    id: number;
    slug: string;
    name: string;
    summary: string;
    description: string;
    priceCny: number;
    planLabel: string;
    periodHint: string;
    fulfillType: "card" | "account" | "manual";
    channelTag: string;
    accountWarning: string;
    notice: PlanNotice;
    inStock: boolean;
  };

  type ProductFamily = {
    id: string;
    vendor: string;
    productLabel: string;
    fromPrice: number;
    inStock: boolean;
    plans: FamilyPlan[];
  };

  const shop = document.querySelector<HTMLElement>("[data-testid='subscribe-shop']");
  const bar = document.querySelector<HTMLElement>("[data-testid='checkout-bar']");
  if (!shop || !bar) throw new Error("subscribe shop missing");

  const families = JSON.parse(shop.dataset.families || "[]") as ProductFamily[];
  if (families.length > 0) {
    const first =
      families.find((f) => f.plans.some((p) => p.inStock)) ?? families[0];
    let selectedFamilyId = first.id;
    let selectedProductId =
      first.plans.find((p) => p.inStock)?.id ?? first.plans[0]?.id ?? 0;
    let signedInEmail: string | null = shop.dataset.userEmail?.trim() || null;

    const titleEl = bar.querySelector<HTMLElement>("[data-testid='checkout-title']");
    const typeBadgeEl = bar.querySelector<HTMLElement>("[data-testid='plan-type-badge']");
    const hintEl = bar.querySelector<HTMLElement>("[data-testid='checkout-hint']");
    const summaryNameEl = bar.querySelector<HTMLElement>("[data-testid='summary-plan-name']");
    const summaryPriceEl = bar.querySelector<HTMLElement>("[data-testid='summary-plan-price']");
    const deliveryEl = bar.querySelector<HTMLElement>("[data-testid='notice-delivery']");
    const reqEl = bar.querySelector<HTMLElement>("[data-testid='notice-requirement']");
    const warrantyEl = bar.querySelector<HTMLElement>("[data-testid='notice-warranty']");
    const warnEl = bar.querySelector<HTMLElement>("[data-testid='account-warning']");
    const pillsEl = bar.querySelector<HTMLElement>("[data-testid='plan-pills']");
    const form = bar.querySelector<HTMLFormElement>("#checkout-form");
    const errorEl = bar.querySelector<HTMLElement>("#checkout-error");
    const submitBtn = form?.querySelector<HTMLButtonElement>("button[type=submit]");

    // Auth controls
    const signedBox = document.getElementById("auth-signed-box");
    const verifiedEmailText = document.getElementById("verified-email-text");
    const switchAccountBtn = document.getElementById("switch-account-btn");
    const otpBox = document.getElementById("auth-otp-box");
    const emailInput = document.getElementById("checkout-email") as HTMLInputElement | null;
    const captchaInput = document.getElementById("checkout-captcha") as HTMLInputElement | null;
    const captchaImg = document.getElementById("checkout-captcha-img") as HTMLImageElement | null;
    const captchaRefreshBtn = document.getElementById("checkout-captcha-refresh");
    const otpInput = document.getElementById("checkout-otp") as HTMLInputElement | null;
    const sendOtpBtn = document.getElementById("send-otp-btn") as HTMLButtonElement | null;
    const otpStatusEl = document.getElementById("otp-status");

    let captchaId = "";

    async function loadCaptcha() {
      if (!captchaImg) return;
      try {
        const res = await fetch("/api/auth/captcha", { cache: "no-store" });
        if (!res.ok) return;
        const data = await res.json();
        captchaId = data.captchaId || "";
        if (data.svgDataUrl) captchaImg.src = data.svgDataUrl;
        if (captchaInput) captchaInput.value = "";
      } catch {
        /* ignore */
      }
    }

    captchaRefreshBtn?.addEventListener("click", () => {
      void loadCaptcha();
    });

    const cards = Array.from(
      shop.querySelectorAll<HTMLButtonElement>("[data-family-id]"),
    );

    // Policy modal controls
    const modal = document.getElementById("policy-modal");
    const modalTitle = document.getElementById("policy-modal-title");
    const modalWarn = document.getElementById("policy-modal-warning");
    const modalOfficialLabel = document.getElementById("policy-modal-official-label");
    const modalOfficial = document.getElementById("policy-modal-official");
    const modalList = document.getElementById("policy-modal-list");
    const openPolicyBtn = document.getElementById("open-policy-btn");
    const noticeRedPolicyBtn = document.getElementById("notice-red-policy-btn");
    const closePolicyBtn = document.getElementById("close-policy-btn");
    const confirmPolicyBtn = document.getElementById("confirm-policy-btn");

    let cooldownTimer: ReturnType<typeof setInterval> | null = null;
    let cooldownLeft = 0;

    function currentFamily() {
      return families.find((f) => f.id === selectedFamilyId) ?? families[0];
    }

    function currentPlan() {
      const family = currentFamily();
      return family.plans.find((p) => p.id === selectedProductId) ?? family.plans[0];
    }

    function updateSubmitButton() {
      const plan = currentPlan();
      if (!submitBtn || !plan) return;
      submitBtn.disabled = !plan.inStock;
      if (!plan.inStock) {
        submitBtn.textContent = "当前规格已售罄";
      } else if (signedInEmail) {
        submitBtn.textContent = `继续前往支付 · ¥${plan.priceCny}`;
      } else {
        submitBtn.textContent = `验证邮箱并前往支付 · ¥${plan.priceCny}`;
      }
    }

    function renderAuthState() {
      if (signedBox && otpBox) {
        signedBox.hidden = !signedInEmail;
        otpBox.hidden = Boolean(signedInEmail);
      }
      if (verifiedEmailText) {
        verifiedEmailText.textContent = signedInEmail || "";
      }
      if (!signedInEmail && !captchaId) {
        void loadCaptcha();
      }
      updateSubmitButton();
    }

    window.addEventListener("mf:auth-changed", (e) => {
      const detail = (e as CustomEvent<{ email?: string | null }>).detail;
      signedInEmail = detail?.email ?? null;
      renderAuthState();
    });

    function startCooldown(sec: number) {
      if (cooldownTimer) clearInterval(cooldownTimer);
      cooldownLeft = sec;
      const tick = () => {
        if (!sendOtpBtn) return;
        if (cooldownLeft <= 0) {
          if (cooldownTimer) clearInterval(cooldownTimer);
          cooldownTimer = null;
          sendOtpBtn.disabled = false;
          sendOtpBtn.textContent = "重新获取";
          return;
        }
        sendOtpBtn.disabled = true;
        sendOtpBtn.textContent = `${cooldownLeft}s`;
        cooldownLeft -= 1;
      };
      tick();
      cooldownTimer = setInterval(tick, 1000);
    }

    sendOtpBtn?.addEventListener("click", async () => {
      if (!emailInput || !sendOtpBtn) return;
      if (errorEl) errorEl.hidden = true;
      const email = emailInput.value.trim();
      const captchaCode = captchaInput?.value.trim() || "";
      if (!email || !emailInput.checkValidity()) {
        if (errorEl) {
          errorEl.textContent = "请先输入有效的邮箱地址";
          errorEl.hidden = false;
        }
        emailInput.focus();
        return;
      }
      if (!captchaId || !/^[A-Za-z0-9]{4}$/.test(captchaCode)) {
        if (errorEl) {
          errorEl.textContent = "请先输入 4 位图形验证码";
          errorEl.hidden = false;
        }
        if (!captchaId) void loadCaptcha();
        captchaInput?.focus();
        return;
      }
      sendOtpBtn.disabled = true;
      sendOtpBtn.textContent = "发送中…";
      try {
        const res = await fetch("/api/auth/send-otp", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ email, captchaId, captchaCode }),
        });
        const data = await res.json();
        // Captcha is single-use: always rotate after an attempt
        void loadCaptcha();
        if (!res.ok) {
          if (errorEl) {
            errorEl.textContent = data.error || "验证码发送失败";
            errorEl.hidden = false;
          }
          sendOtpBtn.disabled = false;
          sendOtpBtn.textContent = "获取验证码";
          if (data.code === "CAPTCHA_INVALID") captchaInput?.focus();
          return;
        }
        if (otpStatusEl) {
          otpStatusEl.hidden = false;
          if (data.delivery === "dev" && data.devCode) {
            otpStatusEl.textContent = `本地开发模式（未配置发信 Key）：验证码为 ${data.devCode}`;
          } else {
            otpStatusEl.textContent = `验证码已发送至 ${email}，${data.ttlMinutes || 10} 分钟内有效（若未收到请检查垃圾箱）`;
          }
        }
        startCooldown(data.cooldownSec || 60);
        otpInput?.focus();
      } catch {
        if (errorEl) {
          errorEl.textContent = "网络异常，请稍后重试";
          errorEl.hidden = false;
        }
        void loadCaptcha();
        sendOtpBtn.disabled = false;
        sendOtpBtn.textContent = "获取验证码";
      }
    });

    switchAccountBtn?.addEventListener("click", async () => {
      try {
        await fetch("/api/auth/logout", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: "{}",
        });
      } catch {
        /* ignore */
      }
      signedInEmail = null;
      if (otpInput) otpInput.value = "";
      if (otpStatusEl) {
        otpStatusEl.hidden = true;
        otpStatusEl.textContent = "";
      }
      if (errorEl) errorEl.hidden = true;
      renderAuthState();
      window.dispatchEvent(new CustomEvent("mf:auth-changed", { detail: { email: null } }));
      emailInput?.focus();
    });

    function renderCheckout() {
      const family = currentFamily();
      const plan = currentPlan();
      if (!titleEl || !pillsEl || !plan) return;

      const planDisplay = `${family.productLabel} ${plan.planLabel}`;
      const priceDisplay = `¥${plan.priceCny}${plan.periodHint ? " " + plan.periodHint : ""}`;
      titleEl.textContent = `${planDisplay} · ${priceDisplay}`;
      if (summaryNameEl) summaryNameEl.textContent = planDisplay;
      if (summaryPriceEl) summaryPriceEl.textContent = priceDisplay;

      if (typeBadgeEl) {
        if (!plan.inStock) {
          typeBadgeEl.textContent = "已售罄";
          typeBadgeEl.dataset.tone = "oos";
        } else if (plan.fulfillType === "account") {
          typeBadgeEl.textContent = "成品账号";
          typeBadgeEl.dataset.tone = "amber";
        } else if (plan.fulfillType === "manual") {
          typeBadgeEl.textContent = "人工代充";
          typeBadgeEl.dataset.tone = "amber";
        } else if (plan.channelTag) {
          typeBadgeEl.textContent = plan.channelTag;
          typeBadgeEl.dataset.tone = "amber";
        } else {
          typeBadgeEl.textContent = "原号卡密";
          typeBadgeEl.dataset.tone = "cobalt";
        }
      }

      if (hintEl) {
        hintEl.textContent = plan.summary || plan.notice.delivery;
      }

      if (deliveryEl) deliveryEl.textContent = plan.notice.delivery;
      if (reqEl) reqEl.textContent = plan.notice.requirement;
      if (warrantyEl) warrantyEl.textContent = plan.notice.warranty;

      if (warnEl) {
        const w = plan.notice.warning || plan.accountWarning;
        if (w) {
          warnEl.hidden = false;
          warnEl.textContent = w;
        } else {
          warnEl.hidden = true;
          warnEl.textContent = "";
        }
      }

      pillsEl.innerHTML = "";
      for (const p of family.plans) {
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className =
          "plan-pill tabular" +
          (p.id === plan.id ? " active" : "") +
          (p.inStock ? "" : " is-oos");
        btn.textContent = p.inStock
          ? `${p.planLabel} · ¥${p.priceCny}`
          : `${p.planLabel} · 已售罄`;
        btn.dataset.productId = String(p.id);
        btn.dataset.testid = `plan-${p.slug}`;
        btn.setAttribute("aria-pressed", p.id === plan.id ? "true" : "false");
        btn.addEventListener("click", () => {
          selectedProductId = p.id;
          renderCheckout();
        });
        pillsEl.appendChild(btn);
      }

      updateSubmitButton();
    }

    function openPolicyModal() {
      const plan = currentPlan();
      if (!modal || !modalTitle || !modalList || !plan) return;
      modalTitle.textContent = plan.name;
      if (modalWarn) {
        const w = plan.notice.warning || plan.accountWarning;
        if (w) {
          modalWarn.hidden = false;
          modalWarn.textContent = w;
        } else {
          modalWarn.hidden = true;
          modalWarn.textContent = "";
        }
      }
      if (modalOfficial) {
        const hasOfficial = Boolean(plan.notice.officialPolicyText);
        modalOfficial.hidden = !hasOfficial;
        if (modalOfficialLabel) modalOfficialLabel.hidden = !hasOfficial;
        modalOfficial.textContent = hasOfficial ? plan.notice.officialPolicyText : "";
      }
      modalList.innerHTML = "";
      for (const item of plan.notice.policyBullets) {
        if (!item) continue;
        const li = document.createElement("li");
        li.textContent = item;
        modalList.appendChild(li);
      }
      modal.hidden = false;
    }

    function closePolicyModal() {
      if (modal) modal.hidden = true;
    }

    openPolicyBtn?.addEventListener("click", openPolicyModal);
    noticeRedPolicyBtn?.addEventListener("click", openPolicyModal);
    closePolicyBtn?.addEventListener("click", closePolicyModal);
    confirmPolicyBtn?.addEventListener("click", closePolicyModal);
    modal?.addEventListener("click", (e) => {
      if (e.target === modal) closePolicyModal();
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && modal && !modal.hidden) closePolicyModal();
    });

    function selectFamily(id: string) {
      const family = families.find((f) => f.id === id);
      if (!family) return;
      selectedFamilyId = id;
      selectedProductId = family.plans.find((p) => p.inStock)?.id ?? family.plans[0]?.id ?? 0;
      for (const card of cards) {
        const on = card.dataset.familyId === id;
        card.classList.toggle("selected", on);
        card.setAttribute("aria-pressed", on ? "true" : "false");
      }
      renderCheckout();
    }

    for (const card of cards) {
      card.addEventListener("click", () => {
        const id = card.dataset.familyId;
        if (id) selectFamily(id);
      });
    }

    form?.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (!form || !errorEl) return;
      errorEl.hidden = true;
      const plan = currentPlan();
      if (!plan || !plan.inStock) {
        errorEl.textContent = "请选择有货套餐";
        errorEl.hidden = false;
        return;
      }

      if (submitBtn) {
        submitBtn.disabled = true;
      }

      try {
        // Step 1: If not signed in yet, verify email + 6-digit OTP first and cache 90-day session
        if (!signedInEmail) {
          const email = emailInput?.value.trim() || "";
          const code = otpInput?.value.trim() || "";
          if (!email || !emailInput?.checkValidity()) {
            errorEl.textContent = "请输入有效的邮箱地址";
            errorEl.hidden = false;
            emailInput?.focus();
            return;
          }
          if (!/^\d{6}$/.test(code)) {
            errorEl.textContent = "请先获取并输入 6 位数字验证码";
            errorEl.hidden = false;
            otpInput?.focus();
            return;
          }
          if (submitBtn) submitBtn.textContent = "正在验证邮箱…";
          const verifyRes = await fetch("/api/auth/verify-otp", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ email, code }),
          });
          const verifyData = await verifyRes.json();
          if (!verifyRes.ok) {
            errorEl.textContent = verifyData.error || "验证码校验失败";
            errorEl.hidden = false;
            return;
          }
          signedInEmail = verifyData.user?.email || email;
          renderAuthState();
          window.dispatchEvent(
            new CustomEvent("mf:auth-changed", { detail: { email: signedInEmail } }),
          );
        }

        // Step 2: Create order under verified session
        if (submitBtn) submitBtn.textContent = "正在创建订单…";
        const res = await fetch("/api/orders", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ productId: plan.id }),
        });
        const data = await res.json();
        if (res.status === 401) {
          signedInEmail = null;
          renderAuthState();
          window.dispatchEvent(new CustomEvent("mf:auth-changed", { detail: { email: null } }));
          errorEl.textContent = data.error || "登录状态已失效，请重新验证邮箱";
          errorEl.hidden = false;
          return;
        }
        if (!res.ok) {
          errorEl.textContent = data.error || "下单失败";
          errorEl.hidden = false;
          return;
        }
        location.href = `/pay/${data.orderNo}`;
      } catch {
        errorEl.textContent = "网络异常，请稍后重试";
        errorEl.hidden = false;
      } finally {
        updateSubmitButton();
      }
    });

    renderAuthState();
    renderCheckout();
  }
</script>

