---
---

<section class="hero" aria-labelledby="hero-heading" data-magfield-hero>
  <div class="hero-copy">
    <h1 id="hero-heading">全球 AI 订阅，<br class="br-desktop" />卡密与成品号即买即取</h1>
    <p>
      无需注册账号。选定官方套餐并设置查单密码，付款后在本页与历史订单随时取货。
    </p>
  </div>

  <div class="hero-art" aria-hidden="true">
    <svg
      class="dipole-svg"
      viewBox="0 0 380 220"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
    >
      <defs>
        <!-- Soft radial edge mask so outer polar rays fade smoothly into porcelain white -->
        <radialGradient id="field-fade-grad" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color="#ffffff" stop-opacity="1" />
          <stop offset="72%" stop-color="#ffffff" stop-opacity="1" />
          <stop offset="100%" stop-color="#ffffff" stop-opacity="0" />
        </radialGradient>
        <mask id="field-fade-mask">
          <rect x="0" y="0" width="380" height="220" fill="url(#field-fade-grad)" />
        </mask>

        <!-- Magnetic pole ambient glow -->
        <radialGradient id="pole-n-glow" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color="#0f172a" stop-opacity="0.14" />
          <stop offset="100%" stop-color="#0f172a" stop-opacity="0" />
        </radialGradient>
        <radialGradient id="pole-s-glow" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color="#2563eb" stop-opacity="0.22" />
          <stop offset="100%" stop-color="#2563eb" stop-opacity="0" />
        </radialGradient>

        <!-- Crisp bar magnet metallic-cobalt core gradient -->
        <linearGradient id="magnet-bar-grad" x1="0%" y1="0%" x2="100%" y2="0%">
          <stop offset="0%" stop-color="#0f172a" />
          <stop offset="48%" stop-color="#1e293b" />
          <stop offset="52%" stop-color="#1d4ed8" />
          <stop offset="100%" stop-color="#2563eb" />
        </linearGradient>

        <!-- Reusable subtle flux loop paths for crisp base + cobalt streams + moving particles -->
        <path id="mf-up-1" d="M148,103 C158,76 222,76 232,103" />
        <path id="mf-dn-1" d="M148,117 C158,144 222,144 232,117" />

        <path id="mf-up-2" d="M144,102 C142,40 238,40 236,102" />
        <path id="mf-dn-2" d="M144,118 C142,180 238,180 236,118" />

        <path id="mf-up-3" d="M139,103 C108,8 272,8 241,103" />
        <path id="mf-dn-3" d="M139,117 C108,212 272,212 241,117" />

        <path id="mf-up-4" d="M135,105 C64,-10 316,-10 245,105" />
        <path id="mf-dn-4" d="M135,115 C64,230 316,230 245,115" />
      </defs>

      <g class="dipole-field" data-dipole-group transform="rotate(-10 190 110)" mask="url(#field-fade-mask)">
        <!-- Subtle ambient glow behind N / S poles -->
        <circle cx="152" cy="110" r="46" fill="url(#pole-n-glow)" />
        <circle cx="228" cy="110" r="52" fill="url(#pole-s-glow)" />

        <!-- Polar open field lines (left N outward + right S inward) -->
        <g class="polar-lines">
          <line x1="20" y1="110" x2="140" y2="110" />
          <line x1="240" y1="110" x2="360" y2="110" />
          <path d="M136,107 C96,95 62,76 24,52" />
          <path d="M136,113 C96,125 62,144 24,168" />
          <path d="M244,107 C284,95 318,76 356,52" />
          <path d="M244,113 C284,125 318,144 356,168" />
        </g>

        <!-- Clearly visible textbook magnetic dipole field lines -->
        <use href="#mf-up-1" class="field-line line-1" />
        <use href="#mf-dn-1" class="field-line line-1" />
        <use href="#mf-up-2" class="field-line line-2" />
        <use href="#mf-dn-2" class="field-line line-2" />
        <use href="#mf-up-3" class="field-line line-3" />
        <use href="#mf-dn-3" class="field-line line-3" />
        <use href="#mf-up-4" class="field-line line-4" />
        <use href="#mf-dn-4" class="field-line line-4" />

        <!-- Crisp directional chevrons on field lines showing N -> S flux -->
        <g class="field-arrows">
          <path d="M188,80.2 L193,83 L188,85.8" />
          <path d="M188,134.2 L193,137 L188,139.8" />
          <path d="M188,52.8 L193.5,55.5 L188,58.2" />
          <path d="M188,161.8 L193.5,164.5 L188,167.2" />
          <path d="M188,28.8 L193.5,31.5 L188,34.2" />
          <path d="M188,185.8 L193.5,188.5 L188,191.2" />
        </g>

        <!-- Vivid animated cobalt magnetic flux pulses gliding along dipole loops -->
        <use href="#mf-up-1" class="flux-pulse pulse-1" pathLength="100" />
        <use href="#mf-dn-1" class="flux-pulse pulse-2" pathLength="100" />
        <use href="#mf-up-2" class="flux-pulse pulse-3" pathLength="100" />
        <use href="#mf-dn-2" class="flux-pulse pulse-4" pathLength="100" />
        <use href="#mf-up-3" class="flux-pulse pulse-5" pathLength="100" />
        <use href="#mf-dn-3" class="flux-pulse pulse-6" pathLength="100" />

        <!-- Precision dipole core (N | S magnetic bar) -->
        <g class="dipole-core">
          <rect
            x="150"
            y="100"
            width="80"
            height="20"
            rx="10"
            fill="url(#magnet-bar-grad)"
          />
          <line x1="190" y1="100" x2="190" y2="120" stroke="#ffffff" stroke-width="1" opacity="0.35" />
          <text x="167" y="113.4" class="pole-label" text-anchor="middle">N</text>
          <text x="213" y="113.4" class="pole-label" text-anchor="middle">S</text>
        </g>
      </g>
    </svg>
  </div>
</section>

<script>
  const hero = document.querySelector<HTMLElement>("[data-magfield-hero]");
  const fieldGroup = hero?.querySelector<SVGGElement>("[data-dipole-group]");
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (hero && fieldGroup && !reducedMotion) {
    let targetX = 0;
    let targetY = 0;
    let curX = 0;
    let curY = 0;
    let rafId = 0;

    const tick = () => {
      curX += (targetX - curX) * 0.08;
      curY += (targetY - curY) * 0.08;
      const rot = -10 + curX * 0.4;
      fieldGroup.setAttribute(
        "transform",
        `translate(${curX.toFixed(2)} ${curY.toFixed(2)}) rotate(${rot.toFixed(2)} 190 110)`,
      );
      if (Math.abs(targetX - curX) > 0.04 || Math.abs(targetY - curY) > 0.04) {
        rafId = requestAnimationFrame(tick);
      } else {
        rafId = 0;
      }
    };

    const schedule = () => {
      if (!rafId) rafId = requestAnimationFrame(tick);
    };

    hero.addEventListener("pointermove", (e) => {
      if (e.pointerType === "touch") return;
      const rect = hero.getBoundingClientRect();
      const nx = (e.clientX - rect.left) / rect.width - 0.5;
      const ny = (e.clientY - rect.top) / rect.height - 0.5;
      targetX = nx * 8;
      targetY = ny * 6;
      schedule();
    });

    hero.addEventListener("pointerleave", () => {
      targetX = 0;
      targetY = 0;
      schedule();
    });
  }
</script>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    gap: 1.5rem;
    align-items: center;
    max-width: 1120px;
    margin: 0 auto;
    padding: 2rem 1.5rem 1.75rem;
  }

  .hero-copy h1 {
    margin: 0;
    font-size: clamp(1.9rem, 3.6vw, 2.75rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.18;
    color: var(--foreground);
    text-wrap: balance;
  }

  .hero-copy p {
    margin: 1rem 0 0;
    max-width: 31rem;
    font-size: 0.95rem;
    font-weight: 400;
    line-height: 1.65;
    color: var(--muted-foreground);
    text-wrap: balance;
  }

  .hero-art {
    display: flex;
    justify-content: flex-end;
    align-items: center;
  }

  .dipole-svg {
    width: min(100%, 360px);
    height: auto;
    overflow: visible;
  }

  .polar-lines line,
  .polar-lines path {
    stroke: #64748b;
    stroke-width: 1.15;
    stroke-dasharray: 3.5 4.5;
    opacity: 0.42;
    fill: none;
  }

  .field-line {
    fill: none;
    stroke: #475569;
    stroke-linecap: round;
  }

  .line-1 {
    stroke-width: 1.45;
    opacity: 0.62;
  }

  .line-2 {
    stroke-width: 1.35;
    opacity: 0.5;
  }

  .line-3 {
    stroke-width: 1.2;
    opacity: 0.38;
  }

  .line-4 {
    stroke-width: 1.05;
    opacity: 0.26;
  }

  .field-arrows path {
    fill: none;
    stroke: #334155;
    stroke-width: 1.35;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0.58;
  }

  .flux-pulse {
    fill: none;
    stroke: var(--magnetic);
    stroke-width: 2.1;
    stroke-linecap: round;
    stroke-dasharray: 16 84;
    opacity: 0.9;
    animation: flux-travel 6.5s linear infinite;
  }

  .pulse-1 {
    animation-duration: 4.8s;
    animation-delay: -0.6s;
  }

  .pulse-2 {
    animation-duration: 5.4s;
    animation-delay: -2.9s;
  }

  .pulse-3 {
    animation-duration: 6.8s;
    animation-delay: -1.8s;
    stroke-width: 1.85;
    opacity: 0.78;
  }

  .pulse-4 {
    animation-duration: 7.4s;
    animation-delay: -4.9s;
    stroke-width: 1.85;
    opacity: 0.78;
  }

  .pulse-5 {
    animation-duration: 9.2s;
    animation-delay: -3.2s;
    stroke-width: 1.6;
    opacity: 0.62;
    stroke-dasharray: 12 88;
  }

  .pulse-6 {
    animation-duration: 9.8s;
    animation-delay: -7.1s;
    stroke-width: 1.6;
    opacity: 0.62;
    stroke-dasharray: 12 88;
  }

  .dipole-core {
    filter: drop-shadow(0 4px 10px rgba(15, 23, 42, 0.16));
  }

  .pole-label {
    fill: #ffffff;
    font-family: var(--font-mono);
    font-size: 9.5px;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  @keyframes flux-travel {
    from {
      stroke-dashoffset: 100;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .flux-pulse {
      animation: none;
      opacity: 0.3;
      stroke-dasharray: none;
    }
  }

  @media (max-width: 820px) {
    .hero {
      grid-template-columns: 1fr;
      padding: 1.35rem 1rem 1.2rem;
      gap: 0.75rem;
    }

    .br-desktop {
      display: none;
    }

    .hero-art {
      order: -1;
      justify-content: flex-start;
    }

    .dipole-svg {
      width: min(72%, 250px);
    }

    .hero-copy p {
      margin-top: 0.75rem;
      font-size: 0.9rem;
    }
  }
</style>
