---
import { getSessionUser } from "../lib/auth";

const brand = import.meta.env.PUBLIC_BRAND_NAME || "Magfield";
const sessionUser = getSessionUser(Astro.cookies);
---

<header class="site-header" data-testid="site-header">
  <div class="header-inner">
    <a href="/" class="brand" aria-label={`${brand} home`} data-testid="nav-home">
      <span class="brand-text">{brand}</span>
      <svg class="brand-mark" viewBox="0 0 20 20" width="16" height="16" fill="none" aria-hidden="true">
        <path d="M6.2 3.8a7 7 0 0 0 0 12.4M13.8 3.8a7 7 0 0 1 0 12.4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
        <circle cx="10" cy="10" r="2.2" fill="var(--magnetic)" />
      </svg>
    </a>
    <nav class="nav" aria-label="主导航">
      <a href="/#subscribe" data-testid="nav-products">订阅方案</a>
      <a href="/orders" data-testid="nav-orders">历史订单</a>
      <div
        class="nav-user"
        id="header-user-pill"
        data-testid="header-user"
        hidden={!sessionUser}
      >
        <span class="nav-user-dot" aria-hidden="true"></span>
        <span class="nav-user-email" id="header-user-email">
          {sessionUser?.email || ""}
        </span>
        <button
          type="button"
          class="nav-logout"
          id="header-logout-btn"
          data-testid="header-logout"
        >
          退出
        </button>
      </div>
    </nav>
  </div>
</header>

<script>
  const userPill = document.getElementById("header-user-pill");
  const userEmailEl = document.getElementById("header-user-email");
  const logoutBtn = document.getElementById("header-logout-btn");

  function syncHeaderUser(email: string | null) {
    if (!userPill || !userEmailEl) return;
    if (email) {
      userEmailEl.textContent = email;
      userPill.hidden = false;
    } else {
      userEmailEl.textContent = "";
      userPill.hidden = true;
    }
  }

  window.addEventListener("mf:auth-changed", (e) => {
    const detail = (e as CustomEvent<{ email?: string | null }>).detail;
    syncHeaderUser(detail?.email ?? null);
  });

  logoutBtn?.addEventListener("click", async () => {
    try {
      await fetch("/api/auth/logout", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: "{}",
      });
    } catch {
      /* ignore */
    }
    syncHeaderUser(null);
    window.dispatchEvent(new CustomEvent("mf:auth-changed", { detail: { email: null } }));
    if (location.pathname === "/orders") {
      location.reload();
    }
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: color-mix(in srgb, var(--background) 88%, transparent);
    border-bottom: 1px solid var(--border);
    backdrop-filter: blur(14px);
  }

  .header-inner {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0.9rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .brand {
    display: inline-flex;
    flex-direction: row;
    align-items: center;
    gap: 0.42rem;
    white-space: nowrap;
    font-size: 1.08rem;
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1;
    color: var(--foreground);
    text-decoration: none;
  }

  .brand-text {
    display: inline-block;
  }

  .brand-mark {
    display: inline-block;
    flex-shrink: 0;
    color: var(--foreground);
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .nav a {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--muted-foreground);
    text-decoration: none;
    transition: color 0.15s ease;
    white-space: nowrap;
  }

  .nav a:hover {
    color: var(--foreground);
  }

  .nav-user {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.25rem 0.6rem 0.25rem 0.55rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface);
    font-size: 0.78rem;
    color: var(--foreground);
  }

  .nav-user[hidden] {
    display: none;
  }

  .nav-user-dot {
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 999px;
    background: #16a34a;
    flex-shrink: 0;
  }

  .nav-user-email {
    max-width: 11rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-weight: 500;
  }

  .nav-logout {
    border: none;
    background: none;
    padding: 0 0 0 0.35rem;
    margin-left: 0.1rem;
    border-left: 1px solid var(--border);
    font: inherit;
    font-size: 0.74rem;
    color: var(--muted-foreground);
    cursor: pointer;
  }

  .nav-logout:hover {
    color: var(--foreground);
  }

  @media (max-width: 640px) {
    .header-inner {
      padding-inline: 1rem;
    }
    .nav {
      gap: 0.9rem;
    }
    .nav-user-email {
      max-width: 7.5rem;
    }
  }
</style>
